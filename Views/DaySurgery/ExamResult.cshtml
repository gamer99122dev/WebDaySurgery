@using WebToolNet.UtilExtension
@{
    ViewData["Title"] = "檢查報告";
    DateTime resvDate = ViewBag.ResvDate;
    Resv patient = ViewBag.Patient;
    List<Ekg> ekgs = ViewBag.Ekgs;
    List<Cxr> cxrs = ViewBag.Cxrs;
}

<h1>@ViewData["Title"]</h1>
<partial name="_TestEnv" />

@* 高齡者靠頁面上的回鈕，不靠瀏覽器上一頁；帶回原本那天，病歷號模式靠 TempData.Peek 留著 *@
<p><a asp-action="PatientList" asp-route-ResvDate="@resvDate.ToString("yyyy-MM-dd")">‹ 回病人清單</a></p>

@* 表頭跟檢驗資料頁同一個排法，上排身分、下排本次手術 *@
<div class="border rounded bg-light p-3 mb-3">
    <div class="d-flex flex-wrap align-items-baseline gap-3">
        <span class="fs-4 fw-bold">@patient.PName</span>
        <span class="fs-5 text-muted">@patient.MrNo</span>
        <span class="text-muted">@patient.Sex.pMapValue("1", "男", "0", "女")</span>
    </div>
    <div class="d-flex flex-wrap gap-4 mt-3">
        <div>
            <div class="small text-muted">科別</div>
            <div class="text-nowrap">@Sec[patient.SecNo]</div>
        </div>
        <div>
            <div class="small text-muted">醫師</div>
            <div class="text-nowrap">@patient.DrName</div>
        </div>
        <div>
            <div class="small text-muted">手術日期</div>
            <div class="text-nowrap">@resvDate.ToString("yyyy/MM/dd") (@resvDate.pToDayOfWeekCh())</div>
        </div>
    </div>
</div>

@* CXR／KUB／EKG 三項同一頁，順序跟清單的檢查欄一樣 *@
@foreach (ChkItem c in patient.Exams)
{
    <div class="card mb-3">
        @* badge 跟清單同一套，符號本身就分得出來，不是只靠顏色 *@
        <h2 class="card-header h5 mb-0">
            @c.Nam @c.Nam.pMapValue("CXR", "胸部X光", "KUB", "腹部X光", "EKG", "心電圖")
            <span class="badge @c.Flag.pMapValue("V", "bg-success", "!", "bg-warning text-dark", "X", "bg-danger")">@c.Flag.pMapValue("V", "✓", "!", "!", "X", "✗")</span>
        </h2>
        <div class="card-body">
            @* EKG 有報告就列表格；沒報告才看 Flag 分「開了沒出報告」和「沒開單」 *@
            @if (c.Nam == "EKG" && ekgs.Count > 0)
            {
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>檢驗名稱</th>
                            <th>簽收時間</th>
                            <th>報告時間</th>
                            <th>診斷</th>
                            <th>敘述</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Ekg e in ekgs)
                        {
                            @* 先 pLeft 再轉，欄位若含到秒數才不會切錯位；轉不出來會是空字串，跟診斷／敘述一樣沒有就顯示 - *@
                            string rcpDTM = e.RcpDTM.pLeft(11).pSyyymmddhhmm();
                            string rptDTM = e.RptDTM.pLeft(11).pSyyymmddhhmm();
                            <tr>
                                <td class="text-nowrap">@e.OrdNam</td>
                                <td class="text-nowrap">@(rcpDTM == "" ? "-" : rcpDTM)</td>
                                <td class="text-nowrap">@(rptDTM == "" ? "-" : rptDTM)</td>
                                <td>@(e.Diag == "" ? "-" : e.Diag)</td>
                                <td>@(e.Desc == "" ? "-" : e.Desc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (c.Nam == "CXR" && cxrs.Count > 0)
            {
                @* 一張單一個區塊：表頭排成有格線的表格，順序照門診放射報告畫面：放射名稱一整列，
                   之後「時間在左、人在右」兩兩一列；下面 Report／Impression 兩段文字。高齡者靠格線和粗體標題找欄位，不用小灰字 *@
                <div class="vstack gap-3">
                    @foreach (Cxr x in cxrs)
                    {
                        @* 先 pLeft 再轉，欄位若含到秒數才不會切錯位；轉不出來會是空字串，統一顯示 - *@
                        (string Label, string Val)[] heads = new[]
                        {
                            ("申請時間", x.AppDTM.pLeft(11).pSyyymmddhhmm()), ("申請醫師", x.AppNm),
                            ("照片時間", x.RcpDTM.pLeft(11).pSyyymmddhhmm()), ("放射師", x.Tec1),
                            ("報告時間", x.VerDTM.pLeft(11).pSyyymmddhhmm()), ("報告醫師", x.VerNm),
                            ("修改時間", x.ModDTM.pLeft(11).pSyyymmddhhmm()), ("修改版本", x.ModTM),
                        };
                        <div class="border rounded p-3">
                            <table class="table table-bordered align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th class="table-light text-nowrap" style="width: 12%;">放射名稱</th>
                                        <td colspan="3">@(x.OrdNam == "" ? "-" : x.OrdNam)</td>
                                    </tr>
                                    @for (int i = 0; i < heads.Length; i += 2)
                                    {
                                        <tr>
                                            <th class="table-light text-nowrap" style="width: 12%;">@heads[i].Label</th>
                                            <td style="width: 38%;">@(heads[i].Val == "" ? "-" : heads[i].Val)</td>
                                            <th class="table-light text-nowrap" style="width: 12%;">@heads[i + 1].Label</th>
                                            <td style="width: 38%;">@(heads[i + 1].Val == "" ? "-" : heads[i + 1].Val)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @* 內文是這頁的重點，只放大這兩段 (fs-5 = 20px)，不動全站基礎字級；pre-line 保留換行 *@
                            <div class="mt-3">
                                <div class="fw-semibold mb-1">Report</div>
                                <div class="bg-light border rounded p-3 fs-5" style="white-space: pre-line; line-height: 1.6;">@(x.Report == "" ? "-" : x.Report)</div>
                            </div>
                            <div class="mt-3">
                                <div class="fw-semibold mb-1">Impression</div>
                                <div class="bg-light border rounded p-3 fs-5" style="white-space: pre-line; line-height: 1.6;">@(x.Impression == "" ? "-" : x.Impression)</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (c.Flag == "V")
            {
                @* 清單的 Flag 看的是有沒有開單；EKG／CXR 開了單但報告還沒出來會走到這裡，KUB 報告內容待補 *@
                <p class="text-muted mb-0">@(c.Nam == "KUB" ? "已開單，此頁尚未提供報告內容" : "已開單，尚無報告")</p>
            }
            else
            {
                <p class="text-muted mb-0">未開單</p>
            }
        </div>
    </div>
}
