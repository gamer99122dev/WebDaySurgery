@using WebToolNet.UtilExtension
@{
    ViewData["Title"] = "檢驗報告";
    DateTime resvDate = ViewBag.ResvDate;
    Resv patient = ViewBag.Patient;
    List<Lab> labs = ViewBag.Labs;

    // 篩選類別，比對用 AdmLabTeamTbl 的 chTeamNo，名稱在 DB 改字也不會失效；
    // 最後的「其他」不是真的代碼，* 代表「代碼不在這份清單裡的組別」
    (string No, string Name)[] labTeams = new[]
    {
        ("C", "生化"), ("H", "血液"), ("J", "血糖檢查"), ("B", "血庫"), ("*", "其他"),
    };
}

@functions {
    // 對到 OPD 主程式的底色：+ 過高、W 警示 → 紅底白字；- 過低 → 綠底白字；E 不判定 → 黃底黑字
    static string FlagClass(string RPFlag) => RPFlag switch
    {
        "+" or "W" => "text-bg-danger",
        "-" => "text-bg-success",
        "E" => "text-bg-warning",
        _ => "",
    };
}

<h1>@ViewData["Title"]</h1>
<partial name="_TestEnv" />

@* 高齡者靠頁面上的回鈕，不靠瀏覽器上一頁；帶回原本那天，病歷號模式靠 TempData.Peek 留著 *@
<p><a asp-action="PatientList" asp-route-ResvDate="@resvDate.ToString("yyyy-MM-dd")">‹ 回病人清單</a></p>

@* 上排是身分（姓名／病歷號／性別），下排是本次手術的欄位，標題小字放值上面。窄螢幕靠 flex-wrap 自己折 *@
<div class="border rounded bg-light p-3 mb-3">
    <div class="d-flex flex-wrap align-items-baseline gap-3">
        <span class="fs-4 fw-bold">@patient.PName</span>
        <span class="fs-5 text-muted">@patient.MrNo</span>
        <span class="text-muted">@patient.Sex.pMapValue("1", "男", "0", "女")</span>
    </div>
    <div class="d-flex flex-wrap gap-4 mt-3">
        <div>
            <div class="small text-muted">科別</div>
            <div class="text-nowrap">@Sec[patient.SecNo]</div>
        </div>
        <div>
            <div class="small text-muted">醫師</div>
            <div class="text-nowrap">@patient.DrName</div>
        </div>
        <div>
            <div class="small text-muted">手術日期</div>
            <div class="text-nowrap">@resvDate.ToString("yyyy/MM/dd") (@resvDate.pToDayOfWeekCh())</div>
        </div>
    </div>
</div>

@* 預設全勾＝全部顯示，要看什麼再取消掉其他的。「其他」是類別不在上面清單裡的列 (尿液、血清免疫、特殊生化…) *@
<div id="labFilter" class="d-flex flex-wrap align-items-center gap-3 border rounded p-3 mb-3">
    <span class="fw-semibold">顯示類別：</span>
    <div class="btn-group">
        <button type="button" id="labAll" class="btn btn-outline-secondary">全部選取</button>
        <button type="button" id="labNone" class="btn btn-outline-secondary">取消全部選取</button>
    </div>

    @foreach ((string No, string Name) in labTeams)
    {
        <div class="form-check">
            <input type="checkbox" class="form-check-input" style="width: 1.25em; height: 1.25em;" id="team-@No" value="@No" checked />
            <label class="form-check-label text-nowrap" for="team-@No">@Name</label>
        </div>
    }
</div>

<h2 class="h5 mb-2">
    檢驗項目
    <span class="text-muted fw-normal">— 手術日往前 14 天，<span id="labCount">@labs.Count</span> 筆</span>
</h2>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr class="text-nowrap">
                <th>類別</th>
                <th>檢體</th>
                <th>報告日期</th>
                <th>修改時間</th>
                <th>醫令開立日期</th>
                <th>檢驗項目</th>
                <th class="text-end">檢驗值</th>
                <th>單位</th>
                <th class="text-end">低值</th>
                <th class="text-end">高值</th>
                <th>來源</th>
            </tr>
        </thead>
        <tbody>
            @{
                string prevLReqNo = "";
                string prevVfDTM = "";
            }
            @foreach (Lab r in labs)
            {
                @* OPD 同一個檢體編號只在第一列顯示類別／檢體，報告日期則是變動時才顯示 *@
                bool newSpeci = r.LReqNo != prevLReqNo;
                bool newVfDTM = newSpeci || r.VfDTM != prevVfDTM;
                prevLReqNo = r.LReqNo;
                prevVfDTM = r.VfDTM;

                @* 先 pLeft 再轉，欄位若含到秒數才不會切錯位 *@
                string vfDTM = r.VfDTM.pLeft(11).pSyyymmddhhmm();
                string modDTM = r.ModDTM.pLeft(11).pSyyymmddhhmm();
                string appDTM = r.AppDTM.pLeft(11).pSyyymmddhhmm();

                @* data-v 是這一列原本的值：篩選藏列後群組的第一列會換人，JS 要靠它重算哪幾格該顯示 *@
                <tr class="@(newSpeci ? "lab-group-start" : "")" data-team="@r.TeamNo" data-lreq="@r.LReqNo" data-vf="@r.VfDTM">
                    <td class="text-nowrap" data-v="@r.TeamNam">@(newSpeci ? r.TeamNam : "")</td>
                    <td class="text-nowrap" data-v="@r.Speci">@(newSpeci ? r.Speci : "")</td>
                    <td class="text-nowrap" data-v="@vfDTM">@(newVfDTM ? vfDTM : "")</td>
                    @* 修改時間跟類別／檢體一樣，同一張報告只在第一列顯示 *@
                    <td class="text-nowrap" data-v="@modDTM">@(newSpeci ? modDTM : "")</td>
                    <td class="text-nowrap">@appDTM</td>
                    <td>@r.Head</td>
                    <td class="text-end @FlagClass(r.RPFlag)" style="font-variant-numeric: tabular-nums;">@r.Val</td>
                    <td class="text-nowrap">@r.Unit</td>
                    <td class="text-end text-nowrap">@r.NL</td>
                    <td class="text-end text-nowrap">@r.NH</td>
                    @* OPD 是看檢體編號前兩碼分外院／院內，不是看 chSTNam *@
                    <td class="text-nowrap">@(r.LReqNo.pLeft(2) == "80" ? "四方" : "山東")</td>
                </tr>
            }
            @* 空表會被當成還在載入或壞掉。列是固定的，訊息在這裡就定好：一筆都沒有 vs 有資料但類別全被取消勾選；顯不顯示由 apply() 決定 *@
            <tr id="labEmpty" hidden>
                <td colspan="11" class="text-center py-4">@(labs.Count == 0 ? "手術日往前 14 天內沒有檢驗報告" : "類別全部取消勾選了，請勾選要看的類別")</td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    /* 群組第一列上緣加粗線：類別／檢體／日期只印在第一列，中間列四格空白，沒分隔線會被當成缺資料、也看不出屬於哪一組 */
    .lab-group-start td { border-top: 3px solid #adb5bd; }
</style>

@section Scripts {
<script>
    // 資料整份都在畫面上了，篩選就是藏列，不用回後端重查
    const boxes = [...document.querySelectorAll('#labFilter input[type="checkbox"]')];
    const rows = [...document.querySelectorAll('tbody tr[data-team]')];   // 只算資料列，最後那列空表訊息不算
    const known = new Set(boxes.map(b => b.value).filter(v => v !== '*'));

    // 藏完列之後，每組的第一列會換人，類別／檢體／日期要重新算一次貼在哪一列
    function regroup() {
        let prevLReq = null, prevVf = null;

        rows.filter(tr => !tr.hidden).forEach(tr => {
            const newSpeci = tr.dataset.lreq !== prevLReq;
            const newVf = newSpeci || tr.dataset.vf !== prevVf;
            prevLReq = tr.dataset.lreq;
            prevVf = tr.dataset.vf;
            tr.classList.toggle('lab-group-start', newSpeci);   // 群組分隔線跟著第一列走

            // 前四格依序是 類別／檢體／報告日期／修改時間，只有報告日期是看 newVf
            [newSpeci, newSpeci, newVf, newSpeci].forEach((show, i) => {
                tr.cells[i].textContent = show ? tr.cells[i].dataset.v : '';
            });
        });
    }

    function apply() {
        const picked = new Set(boxes.filter(b => b.checked).map(b => b.value));
        const other = picked.delete('*');   // 拿掉「其他」，剩下的才是真的類別代碼

        rows.forEach(tr => {
            const team = tr.dataset.team;
            tr.hidden = !(picked.has(team) || (other && !known.has(team)));
        });

        const shown = rows.filter(tr => !tr.hidden).length;
        document.getElementById('labCount').textContent = shown;
        document.getElementById('labEmpty').hidden = shown > 0;
        regroup();
    }

    function setAll(on) {
        boxes.forEach(b => b.checked = on);
        apply();
    }

    boxes.forEach(b => b.addEventListener('change', apply));
    document.getElementById('labAll').addEventListener('click', () => setAll(true));
    document.getElementById('labNone').addEventListener('click', () => setAll(false));

    // 重新整理時瀏覽器會把勾選狀態記回來，但表格是後端重新產生的全部列，先跑一次對齊
    apply();
</script>
}
