@using WebToolNet.UtilExtension
@{
    ViewData["Title"] = "查詢病人清單";
    DateTime resvDate = ViewBag.ResvDate;
    string mrNo = ViewBag.MrNo;
    List<Resv> patients = ViewBag.Patients;
    bool mrNoFound = ViewBag.MrNoFound;

    string listTitle = mrNo == ""
        ? $"{resvDate:yyyy/MM/dd} ({resvDate.pToDayOfWeekCh()}) 病患清單"
        : $"病歷號 {mrNo}　{DateTime.Today:yyyy/MM/dd} 起三個月內的預約";

    // 空表會被當成還在載入或壞掉，要明講；病歷號打錯一位數也是 0 筆，不能讓人以為是沒排刀
    string emptyMsg = mrNo == "" ? "這一天沒有預定住院手術的病人"
        : mrNoFound ? $"病歷號 {mrNo} 三個月內沒有預約"
        : $"查無病歷號 {mrNo}，請確認號碼是否正確";
}

<h1>@ViewData["Title"] <a asp-action="PatientListHelp" asp-route-ResvDate="@resvDate.ToString("yyyy-MM-dd")" class="fs-6 align-middle">欄位說明</a></h1>
<partial name="_TestEnv" />

@* 兩個獨立查詢，各自一個 form。條碼槍刷病歷號等於打完數字再按 Enter，分開才不會誤送日期那張 *@
<div class="d-flex flex-wrap align-items-end gap-4">

    @* 主動線：看某一天的手術名單。
       不用 onchange 自動送出：Chrome 的 date input 用鍵盤打年份時每個數字都會觸發 change，打到一半就查出去了。
       「查詢」要放在前一日／後一日前面，Enter 才會落在它身上，不會變成前一日 *@
    <form method="post" asp-action="PatientListSearch">
        <label for="ResvDate" class="form-label">手術日期 (西元)</label>
        <div class="d-flex gap-2">
            <input type="date" id="ResvDate" name="ResvDate" class="form-control" style="width: 10rem;"
                   value="@resvDate.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary">查詢</button>
            <div class="btn-group">
                <button type="submit" name="Nav" value="prev" class="btn btn-outline-secondary">‹ 前一日</button>
                <button type="submit" name="Nav" value="today" class="btn btn-outline-secondary">今日</button>
                <button type="submit" name="Nav" value="next" class="btn btn-outline-secondary">後一日 ›</button>
            </div>
        </div>
    </form>

    @* 例外查詢：直接找特定某個人 *@
    <form method="post" asp-action="PatientListSearch">
        @* 日期要跟著帶，空白按「查病歷號」或掃錯條碼才會停在原本那天，不會默默跳回今天 *@
        <input type="hidden" name="ResvDate" value="@resvDate.ToString("yyyy-MM-dd")" />
        <label for="ChartNo" class="form-label">病歷號</label>
        <div class="d-flex gap-2">
            <input type="text" id="ChartNo" name="ChartNo" class="form-control" style="width: 9rem;"
                   inputmode="numeric" autocomplete="off" maxlength="10" value="@mrNo" />
            <button type="submit" class="btn btn-primary text-nowrap">查病歷號</button>
        </div>
    </form>

</div>

<h2 class="h5 mt-4 mb-2">
    @listTitle
    <span class="text-muted fw-normal">— @patients.Count 筆</span>
</h2>

<div class="table-responsive">
    <table class="table table-bordered align-middle" id="patientTable">
        <thead class="table-light">
            <tr class="text-nowrap">
                <th>預定住院手術日期</th>
                <th>病人姓名</th>
                <th>病歷號</th>
                <th>性別</th>
                <th>連絡電話</th>
                <th>科別</th>
                <th>醫師</th>
                <th>手術排程</th>
                <th>術式</th>
                <th>檢驗</th>
                <th>檢查</th>
                <th>備血</th>
                <th>麻醉紀錄</th>
                <th>術後床號</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Resv r in patients)
            {
                DateTime pDate = r.PDate.pToDateTime();

                // 三項全 ✗ 就沒東西可看，那格不擺按鈕，免得邀請人點進空頁
                bool anyLab = false;
                foreach (ChkItem c in r.Labs) if (c.Flag != "X") anyLab = true;
                bool anyExam = false;
                foreach (ChkItem c in r.Exams) if (c.Flag != "X") anyExam = true;

                <tr>
                    <td class="text-nowrap">@pDate.ToString("yyyy/MM/dd")</td>
                    <td class="text-nowrap">@r.PName</td>
                    <td class="text-nowrap">@r.MrNo</td>
                    <td>@r.Sex.pMapValue("1", "男", "0", "女")</td>
                    @* 兩支電話各佔一行，只有一支就不會多出空行 *@
                    <td class="text-nowrap">
                        @foreach (string tel in new[] { r.TelH, r.TelO }.Where(t => t != ""))
                        {
                            <div>@tel</div>
                        }
                    </td>
                    <td class="text-nowrap">@Sec[r.SecNo]</td>
                    <td class="text-nowrap">@r.DrName</td>
                    @* 日期、時間各佔一行，置中 *@
                    <td class="text-nowrap text-center">
                        @if (r.OpSch == "")
                        {
                            @: —
                        }
                        @foreach (string part in r.OpSch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div>@part</div>
                        }
                    </td>
                    @* 術式名稱動輒上百字，這欄不能 nowrap，會把整張表撐開 *@
                    <td>@(r.OpName == "" ? "—" : r.OpName)</td>
                    @* 一項一行。符號本身就分得出來，不是只靠顏色 *@
                    <td class="text-nowrap">
                        @if (r.Labs.Count == 0)
                        {
                            @: —
                        }
                        @foreach (ChkItem c in r.Labs)
                        {
                            <div>
                                @c.Nam
                                <span class="badge @c.Flag.pMapValue("V", "bg-success", "!", "bg-warning text-dark", "X", "bg-danger")">@c.Flag.pMapValue("V", "✓", "!", "!", "X", "✗")</span>
                            </div>
                        }
                        @* 檢驗資料頁一次看全部類別，一格只放一個入口；三行都做成連結會讓人以為點哪一類看哪一類 *@
                        @* 做成真的按鈕，鍵盤 Tab + Enter 也能進去，不是只有滑鼠點得到 *@
                        @* 查病歷號時每列的手術日期都不一樣，form 只能一列一張，不能整張表共用 *@
                        @if (anyLab)
                        {
                            <form method="post" asp-action="LabResultSearch" class="mt-1">
                                <input type="hidden" name="ResvDate" value="@pDate.ToString("yyyy-MM-dd")" />
                                <button type="submit" name="MrNo" value="@r.MrNo" class="btn btn-outline-primary btn-sm">檢驗報告</button>
                            </form>
                        }
                    </td>
                    <td class="text-nowrap">
                        @if (r.Exams.Count == 0)
                        {
                            @: —
                        }
                        @foreach (ChkItem c in r.Exams)
                        {
                            <div>
                                @c.Nam
                                <span class="badge @c.Flag.pMapValue("V", "bg-success", "!", "bg-warning text-dark", "X", "bg-danger")">@c.Flag.pMapValue("V", "✓", "!", "!", "X", "✗")</span>
                            </div>
                        }
                        @* 跟檢驗欄一樣：三項同一頁、一格一個入口；有開單的那項頁上才有東西，沒開的會寫無結果 *@
                        @if (anyExam)
                        {
                            <form method="post" asp-action="ExamResultSearch" class="mt-1">
                                <input type="hidden" name="ResvDate" value="@pDate.ToString("yyyy-MM-dd")" />
                                <button type="submit" name="MrNo" value="@r.MrNo" class="btn btn-outline-primary btn-sm">檢查報告</button>
                            </form>
                        }
                    </td>
                    @* 只有一項醫令，開了就是 ✓，沒開就是 ✗ *@
                    <td class="text-nowrap">
                        <span class="badge @(r.BloodPrep ? "bg-success" : "bg-danger")">@(r.BloodPrep ? "✓" : "✗")</span>
                    </td>
                    @* 網址得先跟麻醉系統的 API 換，寫不進 href，只好也走一張 form；開新分頁才不會弄丟這張清單 *@
                    <td class="text-nowrap">
                        <form method="post" asp-action="AnesRecord" target="_blank">
                            <input type="hidden" name="ResvDate" value="@pDate.ToString("yyyy-MM-dd")" />
                            <button type="submit" name="MrNo" value="@r.MrNo" class="btn btn-outline-primary btn-sm">門診評估單</button>
                        </form>
                    </td>
                    @* 術後床號：只先開欄位，資料來源還沒定，先一律顯示 — *@
                    <td class="text-nowrap">—</td>
                </tr>
            }
            @if (patients.Count == 0)
            {
                <tr><td colspan="14" class="text-center py-4">@emptyMsg</td></tr>
            }
        </tbody>
    </table>
</div>
