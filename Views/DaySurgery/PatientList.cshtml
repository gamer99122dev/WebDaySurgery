@using System.Data
@using WebToolNet.UtilExtension
@{
    ViewData["Title"] = "查詢病人清單";
    DateTime opDate = ViewBag.OPDate;
    DataTable patients = ViewBag.Patients;
}

<h1>@ViewData["Title"]</h1>

@* 兩個獨立查詢，各自一個 form。條碼槍刷病歷號等於打完數字再按 Enter，分開才不會誤送日期那張 *@
<div class="d-flex flex-wrap align-items-end gap-4">

    @* 主動線：看某一天的手術名單。改日期就直接查，不用再按一次按鈕 *@
    <form method="post">
        <label for="OPDate" class="form-label">手術日期 (西元)</label>
        <div class="d-flex gap-2">
            <input type="date" id="OPDate" name="OPDate" class="form-control" style="width: 10rem;"
                   value="@opDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            <div class="btn-group">
                <button type="submit" name="Nav" value="prev" class="btn btn-outline-secondary">‹ 前一日</button>
                <button type="submit" name="Nav" value="today" class="btn btn-outline-secondary">今日</button>
                <button type="submit" name="Nav" value="next" class="btn btn-outline-secondary">後一日 ›</button>
            </div>
        </div>
    </form>

    @* 例外查詢：直接找特定某個人 *@
    <form method="post">
        <label for="ChartNo" class="form-label">病歷號</label>
        <div class="d-flex gap-2">
            <input type="text" id="ChartNo" name="ChartNo" class="form-control" style="width: 9rem;"
                   inputmode="numeric" autocomplete="off" maxlength="10" />
            <button type="submit" class="btn btn-primary text-nowrap">查病歷號</button>
        </div>
    </form>

</div>

<h2 class="h5 mt-4 mb-2">
    @opDate.ToString("yyyy/MM/dd") (@opDate.pToDayOfWeekCh()) 病患清單
    <span class="text-muted fw-normal">— @patients.Rows.Count 筆</span>
</h2>

@* 整張表包一個 form，點列＝送出該列的病歷號查檢驗，病歷號走 POST 不進網址 *@
<form method="post" asp-action="LabResult" id="labForm">
<input type="hidden" name="OPDate" value="@opDate.ToString("yyyy-MM-dd")" />

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr class="text-nowrap">
                <th>預定住院手術日期</th>
                <th>病人姓名</th>
                <th>病歷號</th>
                <th>性別</th>
                <th>科別</th>
                <th>醫師</th>
                <th>術式</th>
                <th>手術排程</th>
                <th>檢驗</th>
                <th>檢查</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow r in patients.Rows)
            {
                <tr style="cursor: pointer;">
                    <td class="text-nowrap">@opDate.ToString("yyyy/MM/dd")</td>
                    @* 姓名做成真的按鈕，鍵盤 Tab + Enter 也能進去，不是只有滑鼠點得到 *@
                    <td class="text-nowrap">
                        <button type="submit" name="MrNo" value="@r["chRsMrNo"]" class="btn btn-link p-0 align-baseline">@r["chRsPName"]</button>
                    </td>
                    <td class="text-nowrap">@r["chRsMrNo"]</td>
                    <td>@r["chRsPSex"]</td>
                    <td class="text-nowrap">@Sec[r.pCol("chRsPSec")]</td>
                    <td class="text-nowrap">@r["chRsDrID1Name"]</td>
                    <td>—</td>
                    <td class="text-nowrap">—</td>
                    <td class="text-nowrap">—</td>
                    <td class="text-nowrap">—</td>
                </tr>
            }
        </tbody>
    </table>
</div>
</form>

@section Scripts {
<script>
    // 點整列＝點該列姓名那顆按鈕。姓名本身有 button，點它會重複觸發，所以跳過
    document.querySelectorAll('#labForm tbody tr').forEach(tr => tr.addEventListener('click', e => {
        if (!e.target.closest('button')) tr.querySelector('button[name="MrNo"]').click();
    }));
</script>
}
