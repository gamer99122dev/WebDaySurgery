{
  "ConnectionStrings": {
    // 測試 DB 用 Windows 驗證，開發者的 AD 帳號本來就連得上，所以這個檔沒有任何密碼、可以進 git。
    // 同事 clone 完直接 F5，不用設 User Secrets、不用問人要帳密。
    // TrustServerCertificate=True：測試機的憑證不是內部 CA 簽的。Encrypt 仍是 True，流量有加密。
    "Test": "Server=172.17.2.19;Database=DB_OPD;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;",
    // 本機選「正式DB」用這條，一樣是 Windows 驗證、沒密碼。這個檔只在 Development 載入，IIS 正式站不會讀到，
    // 正式站的連線字串（SQL 帳號）永遠只在 DPAPI 密文檔裡。
    "Production": "Server=172.17.2.31;Database=DB_OPD;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
